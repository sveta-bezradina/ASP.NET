@model IEnumerable<CompanyApp.Models.Company>

    <h1>Companies</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Employee Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var company in Model)
        {
            <tr>
                <td>@company.Name</td>
                <td>@company.Location</td>
                <td>@company.EmployeeCount</td>
            </tr>
        }
        </tbody>
    </table>
