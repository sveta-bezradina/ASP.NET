@{
    ViewData["Title"] = "Завантаження файлу";
}

<h2>Завантажити файл</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form method="post">
    <div class="form-group">
        <label for="firstName">Ім'я:</label>
        <input type="text" id="firstName" name="firstName" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="lastName">Прізвище:</label>
        <input type="text" id="lastName" name="lastName" class="form-control" required />
    </div>

    <div class="form-group">
        <label for="fileName">Назва файлу:</label>
        <input type="text" id="fileName" name="fileName" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Продовжити</button>
</form>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger mt-2">
        @ViewData["Error"]
    </div>
}
